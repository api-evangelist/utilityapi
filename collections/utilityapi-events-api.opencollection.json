{
  "opencollection": "1.0.0",
  "info": {
    "name": "Utility Accounting Events API",
    "version": "2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Events",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Events",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://utilityapi.com/api/v2/events",
            "params": [
              {
                "name": "limit",
                "value": "",
                "type": "query"
              },
              {
                "name": "next",
                "value": "",
                "type": "query"
              },
              {
                "name": "type",
                "value": "",
                "type": "query",
                "description": "Filter by event type"
              }
            ]
          },
          "docs": "List webhook events for the authenticated account."
        },
        {
          "info": {
            "name": "Get Event",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://utilityapi.com/api/v2/events/:uid",
            "params": [
              {
                "name": "uid",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the resource"
              }
            ]
          },
          "docs": "Retrieve a specific webhook event by UID."
        },
        {
          "info": {
            "name": "Modify Event",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://utilityapi.com/api/v2/events/:uid",
            "params": [
              {
                "name": "uid",
                "value": "",
                "type": "path",
                "description": "Unique identifier of the resource"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update metadata on an event."
        }
      ]
    }
  ],
  "bundled": true
}